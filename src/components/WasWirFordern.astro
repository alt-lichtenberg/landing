---
const demands = [
  {
    title: 'Weniger Verkehr',
    text: 'Unser Kiez wird als Abkürzung genutzt. Das wollen wir ändern. Wir fordern verkehrsberuhigende Maßnahmen wie Tempolimits und Spielstraßen und ein Ende des KFZ-Durchgangsverkehrs z.B. durch Einbahnstraßen oder Modalfilter. Wir brauchen ein ganzheitliches Konzept.',
    icon: 'no-car',
    bg: 'bg-[#fff1e0]',
  },
  {
    title: 'Gute Überquerungen',
    text: 'Wir wollen mehr Überquerungshilfen für Fußgänger:innen, z.B. Zebrastreifen, vorgezogene Seitenräume oder Verkehrsinseln. Besonders vor Spielplätzen, Schulen, Senioren- und Förderzentren. Wir wünschen uns längere Ampelschaltungen.',
    icon: 'crossing',
    bg: 'bg-[#ffe0d6]',
  },
  {
    title: 'Sichere Mobilität für alle',
    text: 'Alle Verkehrsteilnehmer:innen sollen sich sicher im Kiez bewegen können. Unabhängig von Alter und Fortbewegungshilfen wie z.B. Rollatoren und Rollstühlen. Mit oder ohne Kinderwagen.',
    icon: 'family',
    bg: 'bg-[#dcdef7]',
  },
  {
    title: 'Mehr Orte zum Verweilen',
    text: 'Wir fordern mehr Raum für Grün und Sitzmöglichkeiten. Der öffentliche Raum soll zum Verweilen einladen und das Miteinander stärken.',
    icon: 'bench',
    bg: 'bg-[#c8f0b8]',
  },
];

const iconSvgs: Record<string, string> = {
  'no-car': `<svg viewBox="0 0 100 100" class="w-24 h-24 mx-auto"><circle cx="50" cy="50" r="45" fill="none" stroke="#333" stroke-width="3"/><line x1="20" y1="80" x2="80" y2="20" stroke="#333" stroke-width="3"/><text x="50" y="55" text-anchor="middle" font-size="24">🚗</text></svg>`,
  'crossing': `<svg viewBox="0 0 100 100" class="w-24 h-24 mx-auto"><text x="50" y="60" text-anchor="middle" font-size="48">🚶</text></svg>`,
  'family': `<svg viewBox="0 0 100 100" class="w-24 h-24 mx-auto"><text x="50" y="60" text-anchor="middle" font-size="42">👨‍👩‍👧</text></svg>`,
  'bench': `<svg viewBox="0 0 100 100" class="w-24 h-24 mx-auto"><text x="50" y="60" text-anchor="middle" font-size="42">🌳</text></svg>`,
};
---

<section id="was-wir-fordern" class="py-16 md:py-24 bg-white">
  <div class="max-w-[1200px] mx-auto px-4 sm:px-6 lg:px-8">
    <div class="flex flex-col md:flex-row gap-12">
      <!-- Left: Main text -->
      <div class="md:w-1/3">
        <h2 class="text-3xl font-bold mb-6">Was wir fordern</h2>
        <p class="text-base font-light leading-[1.8]">
          Wir wollen den zunehmenden Durchgangsverkehr zwischen der Bornitzstraße und der Frankfurter Allee in Alt-Lichtenberg stoppen und unseren Kiez sicherer und lebenswerter machen. Wir wünschen uns Verkehrsberuhigung und damit weniger CO2-Emissionen. Wir wünschen uns einen Kiez für die Menschen, der zum Verweilen einlädt und den wir aktiv mitgestalten können.
        </p>
        <a
          href={`${import.meta.env.BASE_URL}konzept`}
          class="inline-flex items-center gap-1 mt-6 text-primary font-bold underline hover:text-primary-dark transition-colors"
        >
          → Unser ganzes Konzept ansehen
        </a>
      </div>

      <!-- Right: 2x2 Grid of demands -->
      <div class="md:w-2/3 grid grid-cols-1 sm:grid-cols-2 gap-6">
        {demands.map(demand => (
          <div class={`scroll-animate rounded-lg p-6 ${demand.bg}`}>
            <div class="mb-4" set:html={iconSvgs[demand.icon]} />
            <h3 class="text-xl font-bold mb-3">{demand.title}</h3>
            <p class="text-sm font-light leading-relaxed">{demand.text}</p>
          </div>
        ))}
      </div>
    </div>
  </div>
</section>
